<Window x:Class="MemoryInspector.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MemoryInspector · Process Explorer"
        Width="1280"
        Height="760"
        MinWidth="1000"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B111B">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="PanelBrush" Color="#121B29" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#243246" />
        <SolidColorBrush x:Key="TextBrush" Color="#ECF2FA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#91A1B7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#58C4DC" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#153E4B" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0D1623" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#182333" />
            <Setter Property="Background" Value="#DDEAF2" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#1B2A3E" />
            <Setter Property="BorderBrush" Value="#38506E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#243B55" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#1F2D40" />
            <Setter Property="RowBackground" Value="#121B29" />
            <Setter Property="AlternatingRowBackground" Value="#101824" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#182538" />
            <Setter Property="Foreground" Value="#B9C9DA" />
            <Setter Property="BorderBrush" Value="#2A3B52" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#214B5C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter Property="Opacity" Value="0.62" />
                    <Setter Property="Background" Value="#2B2027" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="PROCESS EXPLORER"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="12"
                           FontWeight="Bold" />
                <TextBlock Text="Choose a running process"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0" />
                <TextBlock Text="Inspect resource usage and process identity before monitoring."
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="13"
                           Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding ProcessCountDisplay}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right" />
                <TextBlock Text="{Binding LastRefreshedDisplay}"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,14"
                Padding="14"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="SEARCH"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               Margin="2,0,0,5" />
                    <TextBox Text="{Binding SearchText,
                                            UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search process name or executable path" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="PID"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               Margin="2,0,0,5" />
                    <TextBox Text="{Binding PidFilterText,
                                            UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Exact process ID" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="SORT BY"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               Margin="2,0,0,5" />
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}" />
                </StackPanel>

                <CheckBox Grid.Column="3"
                          Content="Descending"
                          IsChecked="{Binding SortDescending}"
                          Margin="0,20,18,0" />

                <CheckBox Grid.Column="4"
                          Content="Auto refresh"
                          IsChecked="{Binding IsAutoRefreshEnabled}"
                          Margin="0,20,18,0" />

                <Button Grid.Column="5"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,18,0,0"
                        MinWidth="90" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Processes}"
                      SelectedItem="{Binding SelectedProcess,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding ProcessName}"
                                        Width="2*" />
                    <DataGridTextColumn Header="PID"
                                        Binding="{Binding ProcessId}"
                                        Width="80" />
                    <DataGridTextColumn Header="CPU"
                                        Binding="{Binding CpuDisplay}"
                                        Width="75" />
                    <DataGridTextColumn Header="Working set"
                                        Binding="{Binding WorkingSetDisplay}"
                                        Width="105" />
                    <DataGridTextColumn Header="Private memory"
                                        Binding="{Binding PrivateMemoryDisplay}"
                                        Width="110" />
                    <DataGridTextColumn Header="Architecture"
                                        Binding="{Binding ArchitectureDisplay}"
                                        Width="95" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding StatusDisplay}"
                                        Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2"
                    Padding="20"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="PROCESS DETAILS"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedProcess.ProcessName,
                                                TargetNullValue=No process selected}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedProcess.StatusMessage,
                                                TargetNullValue=Select a process to view its identity and resource details.}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="PID"
                                       Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding SelectedProcess.ProcessId,
                                                    TargetNullValue=—}"
                                       Style="{StaticResource DetailValueStyle}" />

                            <TextBlock Text="START TIME"
                                       Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding SelectedProcess.StartTimeDisplay,
                                                    TargetNullValue=—}"
                                       Style="{StaticResource DetailValueStyle}" />

                            <TextBlock Text="ARCHITECTURE"
                                       Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding SelectedProcess.ArchitectureDisplay,
                                                    TargetNullValue=—}"
                                       Style="{StaticResource DetailValueStyle}" />

                            <TextBlock Text="VIRTUAL MEMORY"
                                       Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding SelectedProcess.VirtualMemoryDisplay,
                                                    TargetNullValue=—}"
                                       Style="{StaticResource DetailValueStyle}" />

                            <TextBlock Text="EXECUTABLE PATH"
                                       Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding SelectedProcess.ExecutablePathDisplay,
                                                    TargetNullValue=—}"
                                       Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Content="Start Monitoring"
                            Command="{Binding StartMonitoringCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Margin="0,16,0,0" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="90"
                             Height="4"
                             Margin="0,0,12,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy,
                                                  Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding FilterMessage}"
                       Foreground="#F0A66B"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
